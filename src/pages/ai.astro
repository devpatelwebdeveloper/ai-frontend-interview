---
// AI Playground page: tooling for the AI task (not part of the frontend task).
import Playground from "../components/ai/Playground";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Playground · Trailhead</title>
  </head>
  <body>
    <main>
      <header class="pg-header">
        <h1>🤖 Trailhead AI Playground</h1>
        <p>
          Explore the AI task in the browser. Every request uses your latest code in <code>ai/</code>, so
          save a file and ask again to see the effect. No restart needed.
        </p>
      </header>
      <Playground client:load />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7fb;
    --surface: #fff;
    --ink: #1c2230;
    --muted: #677085;
    --line: #e2e5ee;
    --brand: #4b5bdc;
    --brand-soft: #eef0fd;
    --danger: #b42318;
    --danger-soft: #fdecea;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--ink);
    background: var(--bg);
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 64px; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85em; }
  .pg-header h1 { margin: 0 0 6px; letter-spacing: -0.02em; }
  .pg-header p { margin: 0 0 24px; color: var(--muted); max-width: 720px; }
  .pg { display: grid; gap: 20px; }
  .pg-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
  .pg-card h2 { margin: 0 0 12px; font-size: 1.15rem; }
  .pg-muted { color: var(--muted); margin: 0; font-size: 0.9rem; }
  .pg-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .pg-ask { display: flex; gap: 8px; }
  .pg-ask input { flex: 1; padding: 12px 14px; font: inherit; border: 1px solid var(--line); border-radius: 10px; }
  .pg-ask input:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
  .pg button { font: inherit; cursor: pointer; }
  .pg-ask button, .pg-tests-head > button { padding: 10px 18px; border: 0; border-radius: 10px; background: var(--brand); color: #fff; font-weight: 600; }
  .pg button:disabled { opacity: 0.55; cursor: not-allowed; }
  .pg-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pg-chip { border: 1px solid var(--line); background: var(--brand-soft); color: var(--ink); padding: 6px 12px; border-radius: 999px; font-size: 0.85rem; }
  .pg-chip:hover:not(:disabled) { border-color: var(--brand); }
  .pg-result { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 16px; }
  .pg-question { margin: 0 0 10px; color: var(--muted); font-style: italic; }
  .pg-meta { display: flex; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }
  .pg-badge { display: inline-block; padding: 2px 8px; border-radius: 999px; background: var(--brand-soft); color: var(--brand); font-size: 0.78rem; font-weight: 600; }
  .pg-answer { padding: 14px 16px; background: var(--brand-soft); border-radius: 12px; line-height: 1.55; }
  .pg-error { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px; border-radius: 12px; background: var(--danger-soft); color: var(--danger); margin-top: 8px; }
  .pg-error code { white-space: pre-wrap; word-break: break-word; }
  .pg-context { margin-top: 14px; }
  .pg-link { border: 0; background: none; color: var(--brand); padding: 0; font-weight: 600; }
  .pg-context ol { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; }
  .pg-chunk { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
  .pg-chunk-head { display: flex; justify-content: space-between; gap: 12px; font-size: 0.85rem; }
  .pg-chunk-meta { color: var(--muted); font-size: 0.8rem; margin: 2px 0 6px; }
  .pg-chunk pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 0.82rem; max-height: 220px; overflow: auto; background: var(--bg); padding: 8px 10px; border-radius: 8px; }
  .pg-tests-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 12px; }
  .pg-table-wrap { overflow-x: auto; }
  .pg-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .pg-table th, .pg-table td { text-align: left; vertical-align: top; padding: 10px 8px; border-bottom: 1px solid var(--line); }
  .pg-table th { color: var(--muted); font-weight: 600; white-space: nowrap; }
  .pg-table td:first-child { font-weight: 600; white-space: nowrap; }
  .pg-row-error td { background: var(--danger-soft); }
  .pg-row-error code { color: var(--danger); white-space: pre-wrap; word-break: break-word; }
  @media (max-width: 640px) { .pg-ask { flex-direction: column; } .pg-tests-head { flex-direction: column; } }
</style>
